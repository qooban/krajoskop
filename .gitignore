out/
*.tif.aux.xml

# GRASS and QGIS artefacts
grassdata/
*.qgs~
*.qgz~

# Environment
.env
.env.local

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
