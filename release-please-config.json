{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "krajoskop",
      "include-component-in-tag": false,
      "initial-version": "0.0.1",
      "pull-request-title-pattern": "chore(repo): release ${version}",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "docs",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        },
        {
          "type": "refactor",
          "hidden": true
        },
        {
          "type": "chore",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        },
        {
          "type": "build",
          "hidden": true
        }
      ]
    }
  }
}
